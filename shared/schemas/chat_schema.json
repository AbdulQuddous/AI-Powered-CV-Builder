{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chat contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conversation_id",
    "cv_id",
    "message_id",
    "role",
    "content",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "conversation_id": {
      "type": "string",
      "format": "uuid"
    },
    "cv_id": {
      "type": "string",
      "format": "uuid"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "role": {
      "enum": [
        "user",
        "assistant"
      ]
    },
    "content": {
      "type": "string",
      "maxLength": 5000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
