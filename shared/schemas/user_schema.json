{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user_id",
    "email"
  ],
  "properties": {
    "user_id": {
      "type": "integer",
      "minimum": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    }
  }
}
